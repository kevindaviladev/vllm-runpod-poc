# ─────────────────────────────────────────────────────────────────────────────
# SECRETOS DEL DEMO  (cópialo a .env y cámbialos antes de usarlo en serio)
# Todo lo que LiteLLM/Postgres necesitan sale de aquí vía ${VARIABLES}.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres (base de datos de keys, gasto y logs)
POSTGRES_PASSWORD=litellm-demo-pg

# La "llave maestra" de LiteLLM: con ella administras TODAS las demás
LITELLM_MASTER_KEY=sk-master-demo-0001

# Credenciales de la UI de LiteLLM (http://localhost:4000/ui)
UI_USERNAME=admin
UI_PASSWORD=admin-demo-0001

# Dónde vive Ollama (por defecto: dentro de Docker, por red interna)
#  - todo-en-Docker : http://ollama:11434
#  - Ollama nativo  : http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
# Endpoint OpenAI de Ollama (para el provider openai/ de LiteLLM)
OLLAMA_OPENAI_BASE=http://ollama:11434/v1

# Modelo por defecto del demo
OLLAMA_MODEL=qwen2.5:3b

# Tu "virtual key" de demo: la que usarás en curl/opencode (se crea con scripts/02)
DEMO_KEY=sk-demo-local-0001
DEMO_KEY_ALIAS=demo
