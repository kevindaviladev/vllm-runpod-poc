# Copia este archivo a .env y cambia los valores antes de arrancar
#   cp .env.example .env

LITELLM_MASTER_KEY=sk-master-CAMBIAME
POSTGRES_PASSWORD=CAMBIAME-postgres
GRAFANA_PASSWORD=admin

UI_USERNAME=admin
UI_PASSWORD=admin

# El nodo vLLM en RunPod (Tier 1). Copia la URL del proxy del pod y la key
# que le pasaste a vllm serve --api-key.
VLLM_BASE_URL=https://CAMBIAME-8000.proxy.runpod.net/v1
VLLM_API_KEY=sk-vllm-CAMBIAME
